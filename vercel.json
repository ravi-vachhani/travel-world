{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "crm/**/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },

    { "src": "/crm/login\\.php",   "dest": "/crm/login.php" },
    { "src": "/crm/logout\\.php",  "dest": "/crm/logout.php" },
    { "src": "/crm/?$",            "dest": "/crm/index.php" },

    { "src": "/crm/leads/?$",                  "dest": "/crm/leads/index.php" },
    { "src": "/crm/leads/create\\.php",        "dest": "/crm/leads/create.php" },
    { "src": "/crm/leads/view\\.php",          "dest": "/crm/leads/view.php" },
    { "src": "/crm/leads/edit\\.php",          "dest": "/crm/leads/edit.php" },

    { "src": "/crm/customers/?$",              "dest": "/crm/customers/index.php" },
    { "src": "/crm/customers/create\\.php",    "dest": "/crm/customers/create.php" },
    { "src": "/crm/customers/view\\.php",      "dest": "/crm/customers/view.php" },
    { "src": "/crm/customers/edit\\.php",      "dest": "/crm/customers/edit.php" },

    { "src": "/crm/enquiries/?$",              "dest": "/crm/enquiries/index.php" },
    { "src": "/crm/enquiries/create\\.php",    "dest": "/crm/enquiries/create.php" },
    { "src": "/crm/enquiries/view\\.php",      "dest": "/crm/enquiries/view.php" },
    { "src": "/crm/enquiries/edit\\.php",      "dest": "/crm/enquiries/edit.php" },

    { "src": "/crm/followups/?$",              "dest": "/crm/followups/index.php" },
    { "src": "/crm/followups/create\\.php",    "dest": "/crm/followups/create.php" },
    { "src": "/crm/followups/done\\.php",      "dest": "/crm/followups/done.php" },
    { "src": "/crm/followups/edit\\.php",      "dest": "/crm/followups/edit.php" },

    { "src": "/crm/quotations/?$",             "dest": "/crm/quotations/index.php" },
    { "src": "/crm/quotations/create\\.php",   "dest": "/crm/quotations/create.php" },
    { "src": "/crm/quotations/view\\.php",     "dest": "/crm/quotations/view.php" },
    { "src": "/crm/quotations/edit\\.php",     "dest": "/crm/quotations/edit.php" },
    { "src": "/crm/quotations/print\\.php",    "dest": "/crm/quotations/print.php" },

    { "src": "/crm/bookings/?$",               "dest": "/crm/bookings/index.php" },
    { "src": "/crm/bookings/create\\.php",     "dest": "/crm/bookings/create.php" },
    { "src": "/crm/bookings/view\\.php",       "dest": "/crm/bookings/view.php" },
    { "src": "/crm/bookings/edit\\.php",       "dest": "/crm/bookings/edit.php" },

    { "src": "/crm/payments/?$",               "dest": "/crm/payments/index.php" },
    { "src": "/crm/payments/create\\.php",     "dest": "/crm/payments/create.php" },

    { "src": "/crm/documents/?$",              "dest": "/crm/documents/index.php" },
    { "src": "/crm/documents/upload\\.php",    "dest": "/crm/documents/upload.php" },
    { "src": "/crm/documents/verify\\.php",    "dest": "/crm/documents/verify.php" },

    { "src": "/crm/travel/?$",                 "dest": "/crm/travel/index.php" },
    { "src": "/crm/reports/?$",                "dest": "/crm/reports/index.php" },
    { "src": "/crm/settings/?$",               "dest": "/crm/settings/index.php" },

    { "src": "/visa/([a-z0-9-]+)", "dest": "/api/visa-single.php?slug=$1" },
    { "src": "/destinations/([a-z0-9-]+)", "dest": "/api/destination-single.php?slug=$1" },
    { "src": "/services/([a-z0-9-]+)", "dest": "/api/service-single.php?slug=$1" },
    { "src": "/blog/([a-z0-9-]+)", "dest": "/api/blog-single.php?slug=$1" },
    { "src": "/about", "dest": "/api/about.php" },
    { "src": "/contact", "dest": "/api/contact.php" },
    { "src": "/destinations", "dest": "/api/destinations.php" },
    { "src": "/visa", "dest": "/api/visa.php" },
    { "src": "/services", "dest": "/api/services.php" },
    { "src": "/blog", "dest": "/api/blog.php" },
    { "src": "/", "dest": "/api/index.php" }
  ]
}
