{
  "functions": {
    "index.php": { "runtime": "vercel-php@0.6.0" },
    "about.php": { "runtime": "vercel-php@0.6.0" },
    "contact.php": { "runtime": "vercel-php@0.6.0" },
    "destinations/index.php": { "runtime": "vercel-php@0.6.0" },
    "destinations/country.php": { "runtime": "vercel-php@0.6.0" },
    "visa/index.php": { "runtime": "vercel-php@0.6.0" },
    "visa/visa.php": { "runtime": "vercel-php@0.6.0" },
    "services/index.php": { "runtime": "vercel-php@0.6.0" },
    "services/service.php": { "runtime": "vercel-php@0.6.0" },
    "blog/index.php": { "runtime": "vercel-php@0.6.0" },
    "blog/post.php": { "runtime": "vercel-php@0.6.0" }
  },
  "routes": [
    { "src": "/visa/([a-z0-9-]+)", "dest": "/visa/visa.php?slug=$1" },
    { "src": "/destinations/([a-z0-9-]+)", "dest": "/destinations/country.php?slug=$1" },
    { "src": "/services/([a-z0-9-]+)", "dest": "/services/service.php?slug=$1" },
    { "src": "/blog/([a-z0-9-]+)", "dest": "/blog/post.php?slug=$1" },
    { "src": "/about", "dest": "/about.php" },
    { "src": "/contact", "dest": "/contact.php" },
    { "src": "/destinations", "dest": "/destinations/index.php" },
    { "src": "/visa", "dest": "/visa/index.php" },
    { "src": "/services", "dest": "/services/index.php" },
    { "src": "/blog", "dest": "/blog/index.php" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
